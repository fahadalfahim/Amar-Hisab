# Mandatory. Configure in Cloudflare Pages → Settings → Variables and Secrets.
# No demo mode. If these are missing, the app displays a setup-error screen.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Email sign-up requires verified custom SMTP in Supabase Auth.
# Google registration works without this toggle.
VITE_ENABLE_EMAIL_SIGNUP=false

# Optional phone-number OTP login. Requires SMS provider and costs may apply.
# Keep false until you configure Phone Auth + SMS in Supabase.
VITE_ENABLE_PHONE_AUTH=false

# NEVER add a service role key or database password to VITE_ variables.
