{
  "name": "amar-hisab",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/200.html')\"",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node --test tests/offline-smoke.cjs tests/clay-ui.test.cjs tests/glass-ui.test.cjs tests/source-integrity.test.cjs tests/supabase-null-guard.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.0",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "postcss": "8.5.3",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  }
}
